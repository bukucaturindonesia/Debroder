+export type ResolvedPublicMedia = {
+  src: string | null;
+  source: "slot" | "responsive" | "legacy-compatible" | "slot-fallback" | "hidden";
+  slot: PublicMediaSlot;
+  isFallback: boolean;
+  warning?: string;
+};
