+
+export function findCustomProjectDesignPairStructureIssue(value: unknown): CustomDesignPairStructureIssue | null {
+  if (!isRecord(value) || !Array.isArray(value.items)) return null;
+  for (const item of value.items) {
+    if (!isRecord(item) || !Array.isArray(item.designPackages)) continue;
+    for (const designPackage of item.designPackages) {
+      if (!isRecord(designPackage) || !Array.isArray(designPackage.services)) continue;
+      for (const selection of designPackage.services) {
+        if (!isRecord(selection)) continue;
+        const hasPlacement = rawIdentifierPresent(selection.placementId);
+        const hasPrintSize = rawIdentifierPresent(selection.printSizeId);
+        if (hasPlacement && !hasPrintSize) {
+          return {
+            code: "CUSTOM_DESIGN_SIZE_REQUIRED",
+            message: "Pilih Ukuran Desain untuk Posisi Desain yang dipilih."
+          };
+        }
+        if (!hasPlacement && hasPrintSize) {
+          return {
+            code: "CUSTOM_DESIGN_POSITION_REQUIRED",
+            message: "Pilih Posisi Desain untuk Ukuran Desain yang dipilih."
+          };
+        }
+      }
+    }
+  }
+  return null;
+}
+
